# Runtime profile. Production requires a non-empty API_SECRET.
APP_ENV=development
LOG_LEVEL=INFO
API_SECRET=

# Dense vector storage
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=moscow_kb
QDRANT_TIMEOUT=30

# Retrieval
TOP_K=5
DENSE_CANDIDATES_K=50
SPARSE_CANDIDATES_K=50
RRF_K=60
USE_RERANKER=1
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_CANDIDATES_K=50
MAX_CONTEXT_CHARS=14000

# LLM provider: openai_compatible is recommended for customer/vLLM deployments.
# Supported values: openai_compatible, vllm, ollama
LLM_PROVIDER=openai_compatible
LLM_TIMEOUT=180

# External customer LLM / vLLM / OpenAI-compatible gateway
OPENAI_BASE_URL=http://customer-llm:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=customer-model

# Local demo via Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Web UI
RAG_API_PORT=8000
GRADIO_PORT=7860

# Elasticsearch module
ES_PORT=9200
ES_API_PORT=8010
ES_INDEX=kb_chunks
ES_URL=http://elasticsearch:9200
CHUNKS_DIR=/app/data/chunks_json
ES_SEARCH_API_URL=http://es-search-api:8010

# Telegram bot (optional profile)
TELEGRAM_BOT_TOKEN=
