# API auth. If empty, auth middleware is disabled for local development.
API_SECRET=change-me

# Runtime index
INDEX_DIR=/app/data/faiss_index
INDEX_NAME=moscow_kb

# Retrieval
TOP_K=5
USE_BM25=0
BM25_WEIGHT=0.25
BM25_CANDIDATES_K=50
USE_RERANKER=1
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_CANDIDATES_K=50
MAX_CONTEXT_CHARS=14000

# LLM provider: openai_compatible is recommended for customer/vLLM deployments.
# Supported values: openai_compatible, vllm, ollama
LLM_PROVIDER=openai_compatible
LLM_TIMEOUT=180

# External customer LLM / vLLM / OpenAI-compatible gateway
OPENAI_BASE_URL=http://customer-llm:8000/v1
OPENAI_API_KEY=dummy
OPENAI_MODEL=customer-model

# Local demo via Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Web UI
RAG_API_PORT=8000
GRADIO_PORT=7860

# Elasticsearch module
ES_PORT=9200
ES_API_PORT=8010
ES_INDEX=kb_chunks
ES_SEARCH_API_URL=http://es-search-api:8010

# Telegram bot (optional profile)
TELEGRAM_BOT_TOKEN=
